# MIRA Cloud configuration
# Copy these into Render Environment Variables. NEVER commit real secrets.

# Required: create/provide your Groq API key in Render only.
GROQ_API_KEY=

# Optional: PostgreSQL for persistent MIRA memory.
DATABASE_URL=

# Optional model override; default is groq/compound.
MIRA_MODEL=groq/compound

# Optional limits.
MIRA_MAX_HISTORY=12

# Future secure cloud <-> local bridge. Keep secret in Render + local machine only.
MIRA_BRIDGE_SECRET=

# Optional frontend origins, comma-separated. Leave blank to allow all during development.
MIRA_ALLOWED_ORIGINS=
